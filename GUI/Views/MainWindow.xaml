<Window x:Class="Project.GUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Modular RPG Platform &amp; Character Catalog - Desktop GUI"
        Height="720" Width="1080"
        MinHeight="600" MinWidth="850"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title / Top Bar -->
            <RowDefinition Height="*"/>    <!-- Main Tab Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚔️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="MODULAR RPG PLATFORM &amp; CATALOG" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border Background="#45475A" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WPF NATIVE GUI" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚡ Continue Last Save" Command="{Binding ContinueGameCommand}" Margin="4,0" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="💾 Quick Save" Command="{Binding SaveGameCommand}" Margin="4,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="12,8,12,8" SelectedIndex="{Binding SelectedTabIndex}">
            
            <!-- ======================================================== -->
            <!-- TAB 1: CHARACTER CATALOG (Каталог персонажів)            -->
            <!-- ======================================================== -->
            <TabItem Header="📇 Character Catalog" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Filter & Actions Toolbar -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Cards Grid -->
                    </Grid.RowDefinitions>

                    <!-- Catalog Actions Toolbar -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <Button Content="🔄 Refresh Catalog" Command="{Binding RefreshCatalogCommand}" Margin="0,0,6,0"/>
                                <Button Content="📥 Buffer / Prefetch All Portraits" Command="{Binding PrefetchPortraitsCommand}" Margin="0,0,6,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Grid.Column="2">
                                <Button Content="+ Import Raiden" Command="{Binding ImportFromApiCommand}" CommandParameter="raiden" Margin="0,0,6,0"/>
                                <Button Content="+ Import Zhongli" Command="{Binding ImportFromApiCommand}" CommandParameter="zhongli" Margin="0,0,6,0"/>
                                <Button Content="+ Import Venti" Command="{Binding ImportFromApiCommand}" CommandParameter="venti" Margin="0,0,6,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Scrollable Cards Container -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Characters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Composite Character Card -->
                                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Margin="8" Width="310" Padding="14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/> <!-- Header & Portrait -->
                                                <RowDefinition Height="Auto"/> <!-- Health Bar -->
                                                <RowDefinition Height="Auto"/> <!-- Combat Attributes -->
                                                <RowDefinition Height="Auto"/> <!-- Gear & Abilities -->
                                            </Grid.RowDefinitions>

                                            <!-- Portrait, Name, Rarity & Badges -->
                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="75"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Character Portrait Image (Cached or URL) -->
                                                <Border Grid.Column="0" Width="68" Height="68" CornerRadius="8" BorderBrush="{StaticResource AccentPurple}" BorderThickness="1.5" Background="#181825" HorizontalAlignment="Left">
                                                    <Image Source="{Binding PortraitPath}" Stretch="UniformToFill">
                                                        <Image.ToolTip>
                                                            <ToolTip Content="{Binding PortraitPath}"/>
                                                        </Image.ToolTip>
                                                    </Image>
                                                </Border>

                                                <!-- Name, Stars, Vision & Nation -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding RarityStars}" Foreground="{StaticResource AccentGold}" FontSize="13" Margin="0,2,0,2"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#313244" CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                                                            <TextBlock Text="{Binding Element}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                                                        </Border>
                                                        <Border Background="#313244" CornerRadius="4" Padding="5,2">
                                                            <TextBlock Text="{Binding WeaponType}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Health Progress Bar -->
                                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                                <Grid>
                                                    <TextBlock Text="HEALTH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding HealthDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ProgressBar Value="{Binding HealthPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,3,0,0" Foreground="{StaticResource AccentGreen}" Background="#181825" BorderThickness="0"/>
                                            </StackPanel>

                                            <!-- Combat Attribute Tags -->
                                            <Border Grid.Row="2" Background="#242436" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                                                <UniformGrid Columns="4">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="ATK" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Power}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="ARM" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Armor}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="SPD" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Speed}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="RES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Resistance, StringFormat={}{0:P0}}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </Border>

                                            <!-- Equipped Gear & Status Details -->
                                            <StackPanel Grid.Row="3">
                                                <TextBlock Text="EQUIPMENT &amp; SKILLS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                                <ItemsControl ItemsSource="{Binding EquippedItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding StringFormat='🗡 {0}'}" FontSize="11" Foreground="{StaticResource AccentGold}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ======================================================== -->
            <!-- TAB 2: TEXT GAME CONSOLE (Текстова гра)                  -->
            <!-- ======================================================== -->
            <TabItem Header="⚔️ Text Game Console" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Action Buttons (Save/Load/Duel) -->
                        <RowDefinition Height="*"/>    <!-- Text Output Box -->
                        <RowDefinition Height="Auto"/> <!-- Interactive Command Line Bar -->
                    </Grid.RowDefinitions>

                    <!-- Game Control Bar -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Duel Controls -->
                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Attacker:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" DisplayMemberPath="Name" Width="120" Margin="0,0,10,0"/>

                                <TextBlock Text="Target:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedDuelTarget}" DisplayMemberPath="Name" Width="120" Margin="0,0,10,0"/>

                                <Button Content="⚔️ Launch Duel" Command="{Binding StartDuelCommand}" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>

                            <!-- Save / Load Slots -->
                            <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Slot:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox ItemsSource="{Binding AvailableSaveSlots}" SelectedItem="{Binding SelectedSaveSlot}" Width="130" Margin="0,0,8,0"/>
                                <Button Content="📂 Load" Command="{Binding LoadGameCommand}" Margin="0,0,4,0"/>
                                <Button Content="💾 Save" Command="{Binding SaveGameCommand}" CommandParameter="{Binding SelectedSaveSlot}" Margin="0,0,4,0"/>
                                <Button Content="🧹 Clear" Command="{Binding ClearConsoleCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Text Game Console Window / Output Screen -->
                    <Border Grid.Row="1" Background="#11111B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <TextBox Text="{Binding ConsoleOutput, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 Foreground="#A6E3A1"
                                 FontFamily="Consolas, Cascadia Mono, Courier New"
                                 FontSize="13"
                                 BorderThickness="0"/>
                    </Border>

                    <!-- Command Line Input Bar -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceDark}" CornerRadius="8" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="CLI >" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding CommandInput, UpdateSourceTrigger=PropertyChanged}" Background="#181825" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource CardBorder}" Padding="8,6" FontSize="13" VerticalAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding ExecuteCommandInput}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Content="Run Command" Command="{Binding ExecuteCommandInput}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Footer Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding TotalCharactersCount, StringFormat='Active Characters: {0}'}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
