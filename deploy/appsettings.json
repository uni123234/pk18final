{
  "Application": {
    "Name": "Modular RPG Platform & Character Catalog",
    "Version": "1.0.0",
    "Environment": "Production",
    "ExecutionMode": "WpfGui"
  },
  "Storage": {
    "UseAppData": true,
    "AppDataFolder": "ModularRpgPlatform",
    "CacheSubfolder": "cache/portraits",
    "SavesSubfolder": "saves"
  },
  "RemoteApi": {
    "BaseUrl": "https://genshin.jmp.blue/",
    "TimeoutSeconds": 5,
    "EnableOfflineFallback": true
  },
  "GameDefaults": {
    "MaxRounds": 30,
    "CriticalChance": 0.15,
    "CriticalMultiplier": 1.75
  }
}
